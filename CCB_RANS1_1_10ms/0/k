FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

kInlet          0.375;   // approx k = 1.5*(I*U)^2 ; I = 0.1

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $kInlet;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $kInlet;
    }

    outlet
    {
        type            zeroGradient;
    }

    top
    {
        type            zeroGradient;
    }
    
    bottom
    {
        type            kqRWallFunction;
        value           uniform $kInlet;
    }
    
    CB
    {
        type            kqRWallFunction;
        value           uniform $kInlet;
    }
    
    frontAndBack
    {
        //type            empty;
        type            kqRWallFunction;
        value           uniform $kInlet;
    }
    


    #includeEtc "caseDicts/setConstraintTypes"
}

